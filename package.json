{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-deepseek-v4-anchor",
  "version": "0.1.0",
  "description": "DSH/RL-aligned bootstrap scaffold for DeepSeek V4 Pro sessions in OpenCode",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "docs",
    "patches",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "instrument": "npm run build --silent && node --test dist/test/provider-request.test.js"
  },
  "keywords": [
    "opencode",
    "deepseek",
    "plugin",
    "agent-harness"
  ],
  "license": "MIT",
  "homepage": "https://github.com/MiRinChan/deepseek-opencode-yuanzu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiRinChan/deepseek-opencode-yuanzu.git"
  },
  "bugs": {
    "url": "https://github.com/MiRinChan/deepseek-opencode-yuanzu/issues"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.18"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.18",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
